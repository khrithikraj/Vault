# ai-lab environment template.
# Copy this file to ai-lab/.env and fill in the values you need.
# Never commit real secrets. ai-lab/.env is gitignored.

# --- Provider credentials (used by `npm run ai:list-models` for model discovery) ---

# Google Gemini / Generative Language API key
GEMINI_API_KEY=

# OpenAI API key
OPENAI_API_KEY=

# Cloudflare Workers AI account id + API token (both are required together)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Globally-known variables ---

# TMDB API key. Not required for Phase 0 model discovery, but part of the
# global ai-lab environment contract for later phases.
TMDB_API_KEY=

# Ollama server base URL (Phase 0 discovery does not require an API key).
# Defaults to a local Ollama server when unset.
OLLAMA_BASE_URL=http://localhost:11434