{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Vault extraction contract v1. Provider-independent canonical envelope produced by any vision extraction pipeline and consumed by Vault validators. No provider wire-format quirks are allowed in this schema.",
  "title": "Vault Extraction Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "ocr_version",
    "model_id",
    "category_schema_version",
    "result_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "$comment": "Version of this canonical contract. A literal; exactly \"1.0\".",
      "const": "1.0"
    },
    "prompt_version": {
      "type": "string"
    },
    "ocr_version": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "category_schema_version": {
      "type": "integer"
    },
    "result_status": {
      "enum": ["ok", "nothing_found", "unreadable"]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/extractedItem"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "extractedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_candidates", "fields"],
      "properties": {
        "category_candidates": {
          "$comment": "1..3 candidate categories ordered by descending confidence.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/categoryCandidate"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fieldResult"
          }
        }
      }
    },
    "categoryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "confidence"],
      "properties": {
        "category_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "fieldResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "status", "confidence", "source", "evidence", "verification"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/canonicalValue"
        },
        "status": {
          "$ref": "#/definitions/fieldStatus"
        },
        "confidence": {
          "type": "number"
        },
        "source": {
          "$ref": "#/definitions/fieldSource"
        },
        "evidence": {
          "$ref": "#/definitions/fieldEvidence"
        },
        "verification": {
          "$comment": "Owned by the validator: null until a validator has run.",
          "oneOf": [
            { "$ref": "#/definitions/fieldVerification" },
            { "type": "null" }
          ]
        }
      }
    },
    "canonicalValue": {
      "$comment": "Field values are primitives only. Objects and arrays as values are rejected.",
      "type": ["string", "number", "boolean", "null"]
    },
    "fieldStatus": {
      "enum": ["present", "missing", "unreadable", "not_applicable", "unverified"]
    },
    "fieldSource": {
      "enum": ["image", "external", "user", "system", null]
    },
    "fieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "enum": ["ocr_text", "visual", "none"]
        },
        "text": {
          "type": ["string", "null"]
        }
      }
    },
    "fieldVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "score", "outcome", "reason"],
      "properties": {
        "method": {
          "enum": ["exact", "fuzzy", "visual", "none"]
        },
        "score": {
          "type": ["number", "null"]
        },
        "outcome": {
          "enum": ["accepted", "needs_review", "rejected"]
        },
        "reason": {
          "oneOf": [
            { "$ref": "#/definitions/validationReason" },
            { "type": "null" }
          ]
        }
      }
    },
    "validationReason": {
      "enum": [
        "missing_evidence",
        "ocr_mismatch",
        "invalid_evidence",
        "unknown_field",
        "unknown_category",
        "illegal_source",
        "visual_not_allowed",
        "low_visual_confidence",
        "malformed_category"
      ]
    }
  }
}