# Copy to .env.local and fill in with your Supabase project values.
# Without these the app still boots (landing + auth UI with a "not connected" message),
# but sign-in and the real vault won't work until they're set.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: storage bucket name (defaults to "vault")
# VITE_SUPABASE_BUCKET=vault

# Public Web Push application key. Keep the VAPID private key only in Supabase
# Edge Function secrets; never place it in this file or the browser bundle.
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
